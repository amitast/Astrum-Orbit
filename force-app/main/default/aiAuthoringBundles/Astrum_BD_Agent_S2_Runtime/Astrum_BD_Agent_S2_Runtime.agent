system:
    instructions: "You are Astrum BD Agent S2 Runtime, a sandbox-only validation harness for Opportunity Management. Use only Salesforce data returned by actions. Do not guess. Never delete records. Never perform bulk Opportunity updates. Every write action must require user confirmation before saving."
    messages:
        welcome: "Hi, I'm the Astrum BD Agent S2 runtime tester. How can I help with an Opportunity?"
        error: "Sorry, it looks like something has gone wrong."

config:
    developer_name: "Astrum_BD_Agent_S2_Runtime"
    default_agent_user: "sdr_digital_agent-s4ahbarhynuf@00dud000007zf69.ext"
    agent_label: "Astrum BD Agent S2 Runtime"
    description: "Sandbox-only runtime harness for Astrum BD Agent Subagent 2 Opportunity Management validation."

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "This variable may also be referred to as MessagingEndUser Id"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "This variable may also be referred to as MessagingSession Id"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "This variable may also be referred to as MessagingEndUser ContactId"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "This variable may also be referred to as MessagingSession EndUserLanguage"
    VerifiedCustomerId: mutable string
        description: "This variable may also be referred to as VerifiedCustomerId"
    SelectedOpportunityId: mutable string
        description: "The Salesforce Opportunity Id selected or resolved during the conversation."
    SelectedOpportunityName: mutable string
        description: "The Opportunity name selected or resolved during the conversation."

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent agent_router:
    label: "Agent Router"
    description: "Route the user to the correct Astrum BD Agent validation subagent."

    reasoning:
        instructions: ->
            | Route Opportunity record lookup, search, create, update, next-step capture, and status summary requests to Opportunity Management.
              Route account or contact detail requests to Account and Contact Management.
              Route pipeline hygiene reports, overdue-deal reports, missing-data reports, or cross-record quality checks to Data Quality and Hygiene.
              If the user asks to delete an Opportunity, route to Opportunity Management so the request can be refused.
        actions:
            go_to_opportunity_management: @utils.transition to @subagent.opportunity_management
            go_to_account_and_contact_management: @utils.transition to @subagent.account_and_contact_management
            go_to_data_quality_and_hygiene: @utils.transition to @subagent.data_quality_and_hygiene
            go_to_escalation: @utils.transition to @subagent.escalation
            go_to_off_topic: @utils.transition to @subagent.off_topic
            go_to_ambiguous_question: @utils.transition to @subagent.ambiguous_question

subagent opportunity_management:
    label: "Opportunity Management"
    description: "Handles requests to look up, search, create, update, and summarise individual Salesforce Opportunity records."

    actions:
        get_opportunity_details:
            label: "Get Opportunity Details"
            description: "Retrieve details for one Opportunity by Id, Opportunity Code, Opportunity name, or account name. If multiple records match, return candidates and ask the user to choose one."
            inputs:
                OpportunityId: string
                    description: "Salesforce Opportunity Id, if already known."
                    is_required: False
                OpportunityName: string
                    description: "Opportunity name or partial Opportunity name."
                    is_required: False
                AccountName: string
                    description: "Related Account name or partial Account name."
                    is_required: False
                OpportunityCode: string
                    description: "Astrum Opportunity Code."
                    is_required: False
            outputs:
                Success: boolean
                    description: "Whether a single Opportunity was retrieved."
                MatchCount: integer
                    description: "Number of matching Opportunity records."
                OpportunityId: string
                    description: "Resolved Salesforce Opportunity Id."
                OpportunityName: string
                    description: "Resolved Opportunity name."
                AccountName: string
                    description: "Related Account name."
                StageName: string
                    description: "Current Opportunity stage."
                CloseDate: date
                    description: "Current close date."
                DetailsSummary: string
                    description: "Allowed Opportunity and Account field summary."
                CandidateSummary: string
                    description: "Candidate list when multiple Opportunities match."
                ErrorMessage: string
                    description: "Clear error message if retrieval did not return exactly one record."
            target: "apex://AGENT_GetOpportunityDetails"

        search_opportunities:
            label: "Search Opportunities"
            description: "Search Opportunity records by opportunity name, account name, stage, owner name, or Opportunity Code. Use this when the user asks for candidate Opportunities or supplies a partial name."
            inputs:
                SearchTerm: string
                    description: "Opportunity name search term."
                    is_required: False
                AccountName: string
                    description: "Related Account name search term."
                    is_required: False
                StageName: string
                    description: "Exact Opportunity stage name."
                    is_required: False
                OwnerName: string
                    description: "Opportunity owner name search term."
                    is_required: False
                OpportunityCode: string
                    description: "Exact Astrum Opportunity Code."
                    is_required: False
            outputs:
                ResultsSummary: string
                    description: "Matching Opportunities with allowed fields."
                OpportunityCount: integer
                    description: "Number of matching Opportunities returned."
                ErrorMessage: string
                    description: "Clear error message if search fails."
            target: "apex://AGENT_SearchOpportunities"

        create_opportunity:
            label: "Create Opportunity"
            description: "Create one Opportunity only after the user has supplied all mandatory Astrum fields and explicitly confirms. Never create incomplete records."
            inputs:
                AccountId: string
                    description: "Salesforce Account Id."
                    is_required: False
                AccountName: string
                    description: "Exact related Account name when Account Id is not supplied."
                    is_required: False
                Name: string
                    description: "Opportunity name."
                    is_required: True
                CloseDate: date
                    description: "Opportunity close date."
                    is_required: True
                StageName: string
                    description: "Opportunity stage."
                    is_required: True
                ForecastCategoryName: string
                    description: "Forecast category."
                    is_required: True
                BusinessCategory: string
                    description: "Business category value."
                    is_required: True
                EntitiesProvidingServices: string
                    description: "Entities providing services."
                    is_required: True
                ProjectCategory: string
                    description: "Project category value."
                    is_required: True
                ProjectStartWork: date
                    description: "Project start work date."
                    is_required: True
                ProjectEndWork: date
                    description: "Project end work date."
                    is_required: True
                RfPReceivedDate: date
                    description: "RFP received date."
                    is_required: True
                RfPDueSentDate: date
                    description: "RFP due or sent date."
                    is_required: True
                StudyPhaseType: string
                    description: "Study phase type."
                    is_required: True
                TherapeuticArea: string
                    description: "Therapeutic area."
                    is_required: True
                Amount: number
                    description: "Opportunity amount."
                    is_required: False
                ServiceFees: number
                    description: "Service fees."
                    is_required: False
                NextStep: string
                    description: "Initial next step."
                    is_required: False
            outputs:
                Success: boolean
                    description: "Whether one Opportunity was created."
                OpportunityId: string
                    description: "Created Salesforce Opportunity Id."
                OpportunityName: string
                    description: "Created Opportunity name."
                AccountName: string
                    description: "Related Account name."
                StageName: string
                    description: "Created Opportunity stage."
                CloseDate: date
                    description: "Created Opportunity close date."
                OppProbability: string
                    description: "Created Opportunity Opp_Probability__c value."
                OpportunityCode: string
                    description: "Created Opportunity Code."
                ErrorMessage: string
                    description: "Clear error message if creation fails."
            require_user_confirmation: True
            target: "apex://AGENT_CreateOpportunity"

        check_opportunity_update_risk:
            label: "Check Opportunity Update Risk"
            description: "Read-only precheck for one Opportunity before Update Opportunity Progress Confirm HITL. Retrieves current stage, close date, next step, and Opportunity name, and returns CloseDateIsPast when the proposed close date is earlier than the current date. No DML occurs."
            inputs:
                OpportunityId: string
                    description: "Salesforce Opportunity Id to check."
                    is_required: True
                ProposedCloseDate: date
                    description: "Proposed close date to evaluate before confirmation."
                    is_required: False
            outputs:
                CloseDateIsPast: boolean
                    description: "True when ProposedCloseDate is populated and earlier than the current date."
                CurrentStageName: string
                    description: "Current Opportunity stage."
                CurrentCloseDate: date
                    description: "Current Opportunity close date."
                CurrentNextStep: string
                    description: "Current Opportunity next step."
                OpportunityName: string
                    description: "Opportunity name."
                Success: boolean
                    description: "Whether the Opportunity was found and the check completed."
                ErrorMessage: string
                    description: "Clear error message if the check cannot complete."
            target: "flow://AGENT_CheckOpportunityUpdateRisk"

        update_opportunity_progress:
            label: "Update Opportunity Progress"
            description: "Update one Opportunity's stage, close date, next step, next specific action, next action date, or responsible person after user confirmation. Before using this action for stage or close-date changes, call Check Opportunity Update Risk. If CloseDateIsPast is true, the confirmation prompt must explicitly warn that the proposed close date is in the past."
            inputs:
                OpportunityId: string
                    description: "Salesforce Opportunity Id to update."
                    is_required: True
                NewStageName: string
                    description: "New stage name, if changing stage."
                    is_required: False
                NewCloseDate: date
                    description: "New close date, if changing close date."
                    is_required: False
                NewNextStep: string
                    description: "New NextStep value."
                    is_required: False
                NewNextSpecificAction: string
                    description: "New next specific action."
                    is_required: False
                NewDateOfNextAction: date
                    description: "New date of next specific action."
                    is_required: False
                NewPersonResponsible: string
                    description: "New person responsible for next action."
                    is_required: False
            outputs:
                Success: boolean
                    description: "Whether the update succeeded."
                CloseDateIsPast: boolean
                    description: "Whether the proposed close date was in the past."
                UpdatedOpportunityName: string
                    description: "Updated Opportunity name."
                CurrentStageName: string
                    description: "Stage before update."
                CurrentCloseDate: date
                    description: "Close date before update."
                CurrentNextStep: string
                    description: "Next step before update."
                ErrorMessage: string
                    description: "Clear error message if update fails."
            require_user_confirmation: True
            target: "flow://AGENT_UpdateOpportunityProgress"

        capture_next_steps:
            label: "Capture Next Steps"
            description: "Capture NextStep and optional next-action supporting fields for one Opportunity after user confirmation."
            inputs:
                OpportunityId: string
                    description: "Salesforce Opportunity Id to update."
                    is_required: True
                NewNextStep: string
                    description: "New NextStep value."
                    is_required: True
                NewNextSpecificAction: string
                    description: "New next specific action."
                    is_required: False
                NewDateOfNextAction: date
                    description: "New date of next specific action."
                    is_required: False
                NewPersonResponsible: string
                    description: "New person responsible for next action."
                    is_required: False
            outputs:
                Success: boolean
                    description: "Whether next step capture succeeded."
                CurrentNextStep: string
                    description: "NextStep before update."
                CurrentNextSpecificAction: string
                    description: "Next specific action before update."
                UpdatedOpportunityName: string
                    description: "Updated Opportunity name."
                ErrorMessage: string
                    description: "Clear error message if update fails."
            require_user_confirmation: True
            target: "flow://AGENT_CaptureNextSteps"

        opportunity_status_summary:
            label: "Opportunity Status Summary"
            description: "Summarise current deal status, next action, and visible risk signals using retrieved Salesforce Opportunity and related Account fields only. Excludes D365 notes, Description, migration notes, and external data."
            inputs:
                OpportunityId: string
                    description: "Salesforce Opportunity Id, if already known."
                    is_required: False
                OpportunityName: string
                    description: "Opportunity name or partial Opportunity name."
                    is_required: False
                AccountName: string
                    description: "Related Account name or partial Account name."
                    is_required: False
                OpportunityCode: string
                    description: "Astrum Opportunity Code."
                    is_required: False
            outputs:
                Success: boolean
                    description: "Whether one Opportunity was summarised."
                MatchCount: integer
                    description: "Number of matching Opportunity records."
                OpportunityId: string
                    description: "Resolved Salesforce Opportunity Id."
                OpportunityName: string
                    description: "Resolved Opportunity name."
                AccountName: string
                    description: "Related Account name."
                Summary: string
                    description: "Allowed-field Opportunity status summary."
                CandidateSummary: string
                    description: "Candidate list when multiple Opportunities match."
                ErrorMessage: string
                    description: "Clear error message if summary cannot be produced."
            target: "apex://AGENT_OpportunityStatusSummaryAction"

    reasoning:
        instructions: ->
            | Use only the actions in this subagent for Opportunity work.
              Always retrieve and display the current Opportunity before proposing an update.
              If the request matches more than one Opportunity, present the candidate list and wait for the user to select one.
              Never update more than one Opportunity in a single action. Refuse bulk Opportunity updates.
              Never delete an Opportunity. If the user asks to delete a deal, explain that deletion is outside scope and must be handled by a Salesforce administrator.
              Never use standard Probability or Probability__c. Use only Opp_Probability__c when discussing probability.
              Never pass D365_Opportunity_Notes__c, Description, migration notes, raw long text fields, or external web data into a summary.
              For stage or close-date changes, first use Check Opportunity Update Risk to retrieve current stage, close date, next step, and proposed close-date risk without writing data.
              If Check Opportunity Update Risk returns CloseDateIsPast = true, explicitly warn the user that the proposed close date is in the past before asking for Update Opportunity Progress confirmation.
              After the precheck and warning, use Update Opportunity Progress and require Confirm HITL before saving.
              For next-step-only changes, use Capture Next Steps and require Confirm HITL before saving.
              When stage is progressed, ask for next step information if the user has not provided it.
              When the user asks for a pipeline hygiene report, overdue deal list, missing data report, or cross-record quality check, route or redirect to Data Quality and Hygiene.
              When the user asks for account or contact details, route or redirect to Account and Contact Management.
              When generating an Opportunity Status Summary, use only retrieved Salesforce Opportunity and related Account data and omit blank fields.
        actions:
            get_opportunity_details: @actions.get_opportunity_details
                with OpportunityId=...
                with OpportunityName=...
                with AccountName=...
                with OpportunityCode=...
                set @variables.SelectedOpportunityId = @outputs.OpportunityId
                set @variables.SelectedOpportunityName = @outputs.OpportunityName
            search_opportunities: @actions.search_opportunities
                with SearchTerm=...
                with AccountName=...
                with StageName=...
                with OwnerName=...
                with OpportunityCode=...
            create_opportunity: @actions.create_opportunity
                with AccountId=...
                with AccountName=...
                with Name=...
                with CloseDate=...
                with StageName=...
                with ForecastCategoryName=...
                with BusinessCategory=...
                with EntitiesProvidingServices=...
                with ProjectCategory=...
                with ProjectStartWork=...
                with ProjectEndWork=...
                with RfPReceivedDate=...
                with RfPDueSentDate=...
                with StudyPhaseType=...
                with TherapeuticArea=...
                with Amount=...
                with ServiceFees=...
                with NextStep=...
            check_opportunity_update_risk: @actions.check_opportunity_update_risk
                with OpportunityId=...
                with ProposedCloseDate=...
            update_opportunity_progress: @actions.update_opportunity_progress
                with OpportunityId=...
                with NewStageName=...
                with NewCloseDate=...
                with NewNextStep=...
                with NewNextSpecificAction=...
                with NewDateOfNextAction=...
                with NewPersonResponsible=...
            capture_next_steps: @actions.capture_next_steps
                with OpportunityId=...
                with NewNextStep=...
                with NewNextSpecificAction=...
                with NewDateOfNextAction=...
                with NewPersonResponsible=...
            opportunity_status_summary: @actions.opportunity_status_summary
                with OpportunityId=...
                with OpportunityName=...
                with AccountName=...
                with OpportunityCode=...

subagent account_and_contact_management:
    label: "Account and Contact Management"
    description: "Boundary placeholder for S1 account and contact requests."

    reasoning:
        instructions: ->
            | Tell the user this request belongs to Account and Contact Management, not Opportunity Management, and no S2 Opportunity action was run.

subagent data_quality_and_hygiene:
    label: "Data Quality and Hygiene"
    description: "Boundary placeholder for pipeline hygiene, overdue deal, missing data, and cross-record quality requests."

    reasoning:
        instructions: ->
            | Tell the user this request belongs to Data Quality and Hygiene, not Opportunity Management, and no S2 Opportunity action was run.

subagent escalation:
    label: "Escalation"
    description: "Handles requests from users who want to transfer or escalate their conversation to a live human agent."

    reasoning:
        instructions: ->
            | If a user explicitly asks to transfer to a live agent, escalate the conversation.
              If escalation to a live agent fails for any reason, acknowledge the issue and ask the user whether they would like to log a support case instead.
        actions:
            escalate_to_human: @utils.escalate
                description: "Call this tool to escalate to a human agent."

subagent off_topic:
    label: "Off Topic"
    description: "Redirect conversation to relevant topics when user request goes off-topic."

    reasoning:
        instructions: ->
            | Redirect the conversation to Astrum BD Agent Opportunity, Account, Contact, or Data Quality topics. Do not answer general knowledge questions.

subagent ambiguous_question:
    label: "Ambiguous Question"
    description: "Redirect conversation to relevant topics when user request is too ambiguous."

    reasoning:
        instructions: ->
            | Ask the user to provide a clearer Opportunity, Account, Contact, or Data Quality request.
