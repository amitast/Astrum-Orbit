<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>66.0</apiVersion>

    <description>SAL-9 Closed Won Notification. Sends an immediate Orbit Opportunity email when StageName first transitions to Closed Won. Recipients routed by Business_Category__c and Service_Fees__c matrix. Phase I Unit and Phase I-NIS only — all other categories exit silently. Uses Salesforce_Base_URL Custom Label for production-safe record links. Deployment target: sandbox astrum--astrumpar only. Recipients confirmed 26 Apr 2026 (A-01, A-02, A-03 resolved). Do not activate until A-04 and A-05 are assessed.</description>

    <environments>Default</environments>

    <interviewLabel>Notify Closed Won After Save {!$Flow.CurrentDateTime}</interviewLabel>

    <label>Notify Closed Won After Save</label>

    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>

    <processType>AutoLaunchedFlow</processType>

    <!-- DefaultMode = User context. Never SystemModeWithoutSharing. Memory Pack FR-09. -->
    <runInMode>DefaultMode</runInMode>

    <!-- START: entry criteria 1 AND 2
         1: StageName = 'Closed Won'
         2: StageName IsChanged
         Together these guarantee the Flow fires only on the first transition INTO Closed Won.
         No re-send if the record is edited while already Closed Won.
         ASSUMPTION A-04: deals are never created at Closed Won so Update trigger is sufficient.
         ASSUMPTION A-05: if Stage moves Closed Won → other → Closed Won again, a second email
                          fires. Confirm with Commercial if one-lifetime-only behaviour is required.
         Standard Probability field never referenced — Memory Pack FR-07 NEVER. -->
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Bypass_Permission</targetReference>
        </connector>
        <filterLogic>1 AND 2</filterLogic>
        <filters>
            <field>StageName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed Won</stringValue>
            </value>
        </filters>
        <filters>
            <!-- IsChanged ensures prior StageName was not already 'Closed Won' -->
            <field>StageName</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <!-- Active in sandbox for smoke test. Deployment to production via governed release only. -->
    <status>Active</status>

    <!-- ═══════════════════════════════════════════════════
         DECISIONS — all grouped together (XSD requirement)
         Execution order determined by connector references.
         ═══════════════════════════════════════════════════ -->

    <!-- ELEMENT 1: Check_Bypass_Permission (Decision)
         First element inside the Flow — CLAUDE.md hard rule.
         Exits without sending if running user holds Bypass_Flow custom permission.
         Prevents unintended sends during data loads and integration runs. -->
    <decisions>
        <description>Exits the Flow without sending if the running user holds the Bypass_Flow custom permission. Prevents unintended sends during data loads and integration runs. Required as the first element inside every record-triggered Flow — CLAUDE.md hard rule.</description>
        <label>Check Bypass Permission</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <name>Check_Bypass_Permission</name>
        <defaultConnector>
            <targetReference>Get_Opportunity_Detail</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Proceed</defaultConnectorLabel>
        <rules>
            <name>Bypassed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Bypass_Flow</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Bypassed</label>
            <!-- No connector — Flow terminates. Opportunity save completes normally. -->
        </rules>
    </decisions>

    <!-- ELEMENT 3: Check_Business_Category (Decision)
         Routes by Business_Category__c.
         Phase I Unit   → Check_Phase_I_Unit_Fees
         Phase I-NIS    → Check_Phase_I_NIS_Fees
         All others     → default path (no connector) — silent exit, no email, no error.
         Active picklist values confirmed in org (25 Apr 2026):
           Phase I Unit | Phase I-NIS | S&PS | All Other Projects (Phase I - NIS)
           Phase I Clinical Conduct Portugal | Site & Patient Services (CRP & MissionTEC)
         Only Phase I Unit and Phase I-NIS are in scope per SAL-9. -->
    <decisions>
        <description>Routes the Flow by Business_Category__c. Phase I Unit and Phase I-NIS proceed to fee-threshold decisions. All other Business Category values — including blank — exit silently without sending. No Flow error is thrown and the Opportunity saves normally.</description>
        <label>Check Business Category</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <name>Check_Business_Category</name>
        <defaultConnectorLabel>All Others — Silent Exit</defaultConnectorLabel>
        <!-- No defaultConnector — unrecognised categories terminate the Flow silently. -->
        <rules>
            <name>Phase_I_Unit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Detail.Business_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Phase I Unit</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Phase_I_Unit_Fees</targetReference>
            </connector>
            <label>Phase I Unit</label>
        </rules>
        <rules>
            <name>Phase_I_NIS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Detail.Business_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Phase I-NIS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Phase_I_NIS_Fees</targetReference>
            </connector>
            <label>Phase I-NIS</label>
        </rules>
    </decisions>

    <!-- ELEMENT 4: Check_Phase_I_Unit_Fees (Decision)
         Routes Phase I Unit by Service_Fees__c threshold.
         Threshold EUR 150,000 confirmed for Closed Won 26 Apr 2026 (A-01 resolved).
         Currency: EUR (org default). No currency conversion required. -->
    <decisions>
        <description>Routes Phase I Unit Opportunities by Service_Fees__c. Below EUR 150,000 sends to the low-tier recipient list; at or above sends to the high-tier list. Threshold EUR 150,000 confirmed for Closed Won 26 Apr 2026 (A-01 resolved).</description>
        <label>Check Phase I Unit Fees</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <name>Check_Phase_I_Unit_Fees</name>
        <defaultConnector>
            <targetReference>Send_Closed_Won_Phase_I_Unit_High</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>At or Above EUR 150,000</defaultConnectorLabel>
        <rules>
            <name>Phase_I_Unit_Low</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Detail.Service_Fees__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>150000</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Closed_Won_Phase_I_Unit_Low</targetReference>
            </connector>
            <label>Below EUR 150,000</label>
        </rules>
    </decisions>

    <!-- ELEMENT 5: Check_Phase_I_NIS_Fees (Decision)
         Routes Phase I-NIS by Service_Fees__c threshold.
         Threshold EUR 500,000 confirmed for Closed Won 26 Apr 2026 (A-02 resolved).
         Currency: EUR (org default). No currency conversion required. -->
    <decisions>
        <description>Routes Phase I-NIS Opportunities by Service_Fees__c. Below EUR 500,000 sends to the low-tier recipient list; at or above sends to the high-tier list. Threshold EUR 500,000 confirmed for Closed Won 26 Apr 2026 (A-02 resolved).</description>
        <label>Check Phase I-NIS Fees</label>
        <locationX>704</locationX>
        <locationY>480</locationY>
        <name>Check_Phase_I_NIS_Fees</name>
        <defaultConnector>
            <targetReference>Send_Closed_Won_Phase_I_NIS_High</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>At or Above EUR 500,000</defaultConnectorLabel>
        <rules>
            <name>Phase_I_NIS_Low</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Detail.Service_Fees__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>500000</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Closed_Won_Phase_I_NIS_Low</targetReference>
            </connector>
            <label>Below EUR 500,000</label>
        </rules>
    </decisions>

    <!-- ═══════════════════════════════════════════════════
         RECORD LOOKUPS
         ═══════════════════════════════════════════════════ -->

    <!-- ELEMENT 2: Get_Opportunity_Detail (Get Records)
         Retrieves full Opportunity record so cross-object and custom fields are reliably
         available for routing and email body. storeOutputAutomatically creates the
         Get_Opportunity_Detail sObject variable. Account.Name and Owner.Email are resolved
         by the Flow runtime through relationship traversal — same pattern as SAL-2. -->
    <recordLookups>
        <description>Retrieves the Opportunity record with cross-object Account.Name, Owner.Email, and all custom fields needed for recipient routing and the email body. Required because cross-object fields are not always reliably available directly on the trigger record in after-save context.</description>
        <label>Get Opportunity Detail</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <name>Get_Opportunity_Detail</name>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Business_Category</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

