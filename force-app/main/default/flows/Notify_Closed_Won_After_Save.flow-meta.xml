         Phase I Unit, Service Fees < EUR 150,000.
         Recipients confirmed 26 Apr 2026 (SAL-9 A-03 resolved). -->
    <actionCalls>
        <description>Sends Closed Won notification for Phase I Unit, Service Fees below EUR 150,000. Recipient list confirmed 26 Apr 2026 (SAL-9 A-03 resolved). Fault path captures error without rethrowing so Opportunity DML is never rolled back.</description>
        <label>Send Closed Won — Phase I Unit Low</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <name>Send_Closed_Won_Phase_I_Unit_Low</name>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <faultConnector>
            <targetReference>Handle_Send_Fault</targetReference>
        </faultConnector>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Recipients_Phase_I_Unit_Low</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>Email_Subject</elementReference>
            </value>
        </inputParameters>
