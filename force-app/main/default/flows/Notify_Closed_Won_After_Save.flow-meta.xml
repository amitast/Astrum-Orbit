    <!-- ELEMENT 10: Handle_Send_Fault (Assignment)
         Shared fault terminal for all four Send action calls.
         Captures $Flow.FaultMessage for debug log visibility.
         Does not rethrow — an after-save Flow email failure must not roll back the Opportunity DML.
         No connector — Flow terminates after capturing the fault message. -->
    <assignments>
        <description>Fault terminal for all Closed Won send actions. Captures the fault message into FaultMessage for Flow Interview debug logs. Does not rethrow — after-save Flow email failure must not roll back the Opportunity DML. The Opportunity saves normally when this path is taken.</description>
        <label>Handle Send Fault</label>
        <locationX>1232</locationX>
        <locationY>720</locationY>
        <name>Handle_Send_Fault</name>
        <assignmentItems>
            <assignToReference>FaultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <!-- No connector — Flow terminates here. -->
    </assignments>

