<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>66.0</apiVersion>

    <description>Agentforce autolaunched Flow for Subagent 1. Retrieves a single Contact by ID or LastName with optional AccountName disambiguation. Read-only, no screens, no DML, and no Bypass_Flow decision because this is not record-triggered.</description>

    <environments>Default</environments>

    <interviewLabel>AGENT_GetContactDetails {!$Flow.CurrentDateTime}</interviewLabel>

    <label>AGENT_GetContactDetails</label>

    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>

    <processType>AutoLaunchedFlow</processType>

    <!-- DefaultMode is the metadata value for User or Queue That Launched the Flow. Never SystemModeWithoutSharing. -->
    <runInMode>DefaultMode</runInMode>

    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_ContactId_Provided</targetReference>
        </connector>
    </start>

    <status>Active</status>

    <!-- ═══════════════════════════════════════════════
         ASSIGNMENTS  (schema group 1 of 5)
         ═══════════════════════════════════════════════ -->

    <assignments>
        <description>Populate output variables when a Contact record is found. Email, Phone, and MobilePhone are direct authenticated-user output only and are not Prompt Template inputs.</description>
        <label>Set Success Outputs</label>
        <locationX>176</locationX>
        <locationY>960</locationY>
        <name>Set_Success_Outputs</name>
        <assignmentItems>
            <assignToReference>ContactFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>FullName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Formula_FullName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Title</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Contact.Title</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AccountName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_RelatedAccount.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Department</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Contact.Department</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Email</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Contact.Email</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Phone</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Contact.Phone</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>MobilePhone</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Contact.MobilePhone</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OwnerName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Owner.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>LastModifiedDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Formula_LastModifiedDateText</elementReference>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <description>Set user-safe error outputs when no accessible Contact record is found.</description>
        <label>Set Contact Not Found</label>
        <locationX>44</locationX>
        <locationY>720</locationY>
        <name>Set_Contact_Not_Found</name>
        <assignmentItems>
            <assignToReference>ContactFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Contact not found or not accessible.</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <description>Set user-safe error outputs when a read-only lookup faults. Do not expose internal exception details to the agent response.</description>
        <label>Set Fault - Query Failed</label>
        <locationX>440</locationX>
        <locationY>720</locationY>
        <name>Set_Fault_Query_Failed</name>
        <assignmentItems>
            <assignToReference>ContactFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Unable to retrieve contact details. Verify the contact identifier and your record access.</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <!-- ═══════════════════════════════════════════════
         DECISIONS  (schema group 2 of 5)
         ═══════════════════════════════════════════════ -->

    <decisions>
        <description>Route the lookup by ContactId when present. ContactId takes precedence over LastName and AccountName.</description>
        <label>Check ContactId Provided</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <name>Check_ContactId_Provided</name>
        <defaultConnector>
            <targetReference>Check_AccountName_Provided</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Use LastName</defaultConnectorLabel>
        <rules>
            <name>ContactId_Provided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ContactId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact_By_Id</targetReference>
            </connector>
            <label>ContactId Provided</label>
        </rules>
    </decisions>

    <decisions>
        <description>Route LastName lookup through AccountName disambiguation when AccountName is populated.</description>
        <label>Check AccountName Provided</label>
        <locationX>308</locationX>
        <locationY>240</locationY>
        <name>Check_AccountName_Provided</name>
        <defaultConnector>
            <targetReference>Get_Contact_By_LastName</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No AccountName</defaultConnectorLabel>
        <rules>
            <name>AccountName_Provided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AccountName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AccountName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Input_Account</targetReference>
            </connector>
            <label>AccountName Provided</label>
        </rules>
    </decisions>

    <decisions>
        <description>Determine whether the Contact lookup returned an accessible record before resolving related Account and owner names.</description>
        <label>Evaluate Contact Result</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <name>Evaluate_Contact_Result</name>
        <defaultConnector>
            <targetReference>Get_Related_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Contact Found</defaultConnectorLabel>
        <rules>
            <name>Contact_Not_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_Contact.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Contact_Not_Found</targetReference>
            </connector>
            <label>Contact Not Found</label>
        </rules>
    </decisions>

    <!-- ═══════════════════════════════════════════════
         FORMULAS  (schema group 3 of 5)
         ═══════════════════════════════════════════════ -->

    <formulas>
        <description>Full name output for the retrieved Contact.</description>
        <name>Formula_FullName</name>
        <dataType>String</dataType>
        <expression>{!var_Contact.FirstName} &amp; &quot; &quot; &amp; {!var_Contact.LastName}</expression>
    </formulas>

    <formulas>
        <description>Text output for Contact LastModifiedDate.</description>
        <name>Formula_LastModifiedDateText</name>
        <dataType>String</dataType>
        <expression>TEXT({!var_Contact.LastModifiedDate})</expression>
    </formulas>

    <!-- ═══════════════════════════════════════════════
         RECORD LOOKUPS  (schema group 4 of 5)
         ═══════════════════════════════════════════════ -->

    <recordLookups>
        <description>Retrieve the Contact record by 18-character Salesforce record ID. Stores only the explicit read field set required for the agent action.</description>
        <label>Get Contact by Id</label>
        <locationX>44</locationX>
        <locationY>240</locationY>
        <name>Get_Contact_By_Id</name>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Evaluate_Contact_Result</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Fault_Query_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ContactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <outputReference>var_Contact</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>LastName</queriedFields>
        <queriedFields>Title</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <queriedFields>Department</queriedFields>
        <queriedFields>Email</queriedFields>
        <queriedFields>Phone</queriedFields>
        <queriedFields>MobilePhone</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>LastModifiedDate</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>

    <recordLookups>
        <description>Resolve AccountName to an Account record for LastName plus Account disambiguation.</description>
        <label>Get Input Account</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <name>Get_Input_Account</name>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Contact_By_LastName_And_Account</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Fault_Query_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AccountName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <outputReference>var_InputAccount</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>

    <recordLookups>
        <description>Retrieve the first Contact by LastName and resolved AccountId when AccountName was provided. Stores only the explicit read field set required for the agent action.</description>
        <label>Get Contact by LastName and Account</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <name>Get_Contact_By_LastName_And_Account</name>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Evaluate_Contact_Result</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Fault_Query_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LastName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>LastName</elementReference>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_InputAccount.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <outputReference>var_Contact</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>LastName</queriedFields>
        <queriedFields>Title</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <queriedFields>Department</queriedFields>
        <queriedFields>Email</queriedFields>
        <queriedFields>Phone</queriedFields>
        <queriedFields>MobilePhone</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>LastModifiedDate</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>

    <recordLookups>
        <description>Retrieve the first Contact by LastName when ContactId and AccountName are blank. Stores only the explicit read field set required for the agent action.</description>
        <label>Get Contact by LastName</label>
        <locationX>440</locationX>
        <locationY>360</locationY>
        <name>Get_Contact_By_LastName</name>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Evaluate_Contact_Result</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Fault_Query_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LastName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>LastName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <outputReference>var_Contact</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>FirstName</queriedFields>
        <queriedFields>LastName</queriedFields>
        <queriedFields>Title</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <queriedFields>Department</queriedFields>
        <queriedFields>Email</queriedFields>
        <queriedFields>Phone</queriedFields>
        <queriedFields>MobilePhone</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>LastModifiedDate</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>

    <recordLookups>
        <description>Resolve the Contact parent Account name from AccountId for the agent response.</description>
        <label>Get Related Account</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <name>Get_Related_Account</name>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Owner</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Fault_Query_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_Contact.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <outputReference>var_RelatedAccount</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>

    <recordLookups>
        <description>Resolve the Contact owner display name from OwnerId for the agent response.</description>
        <label>Get Owner</label>
        <locationX>176</locationX>
        <locationY>840</locationY>
        <name>Get_Owner</name>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Success_Outputs</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Fault_Query_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_Contact.OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <outputReference>var_Owner</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>

    <!-- ═══════════════════════════════════════════════
         VARIABLES  (schema group 5 of 5)
         ═══════════════════════════════════════════════ -->

    <variables>
        <description>18-character Contact record ID. Takes precedence over LastName and AccountName when populated.</description>
        <name>ContactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <description>Contact last name for lookup when ContactId is blank.</description>
        <name>LastName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <description>Optional Account Name used with LastName to disambiguate lookup. On success, overwritten with the resolved parent Account.Name for agent output.</description>
        <name>AccountName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>True if an accessible Contact record was returned.</description>
        <name>ContactFound</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Full name of the retrieved Contact.</description>
        <name>FullName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Contact title returned from Contact.Title.</description>
        <name>Title</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Contact department returned from Contact.Department.</description>
        <name>Department</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Contact email returned directly to the authenticated user. This Flow output must not be used as a Prompt Template input.</description>
        <name>Email</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Contact phone returned directly to the authenticated user. This Flow output must not be used as a Prompt Template input.</description>
        <name>Phone</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Contact mobile phone returned directly to the authenticated user. This Flow output must not be used as a Prompt Template input.</description>
        <name>MobilePhone</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Display name of the Contact owner resolved from OwnerId.</description>
        <name>OwnerName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Last modified date/time returned as text for agent display.</description>
        <name>LastModifiedDate</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>User-safe error message returned on not-found and fault paths.</description>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Contact record returned by the selected read-only lookup.</description>
        <name>var_Contact</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>

    <variables>
        <description>Account record returned from the optional AccountName disambiguation lookup.</description>
        <name>var_InputAccount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>

    <variables>
        <description>Parent Account record returned by the Contact AccountId lookup.</description>
        <name>var_RelatedAccount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>

    <variables>
        <description>User record returned by the owner lookup.</description>
        <name>var_Owner</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>User</objectType>
    </variables>

</Flow>
