                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_New_Date_Of_Next_Action</targetReference>
            </connector>
            <label>Date of Next Action Provided</label>
        </rules>
    </decisions>
    <decisions>
        <description>Only assign Person Responsible when the agent supplied a non-blank value.</description>
        <label>Check New Person Responsible Provided</label>
        <locationX>176</locationX>
        <locationY>1920</locationY>
        <name>Check_New_Person_Responsible_Provided</name>
        <defaultConnector>
