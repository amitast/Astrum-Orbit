        </defaultConnector>
        <defaultConnectorLabel>Close Date Blank</defaultConnectorLabel>
        <rules>
            <name>Close_Date_Provided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NewCloseDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_New_Close_Date</targetReference>
            </connector>
            <label>Close Date Provided</label>
        </rules>
    </decisions>
    <decisions>
        <description>Only assign NextStep when the agent supplied a non-blank value.</description>
