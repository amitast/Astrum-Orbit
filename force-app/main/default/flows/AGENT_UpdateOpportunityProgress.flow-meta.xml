        <defaultConnectorLabel>Next Step Blank</defaultConnectorLabel>
        <rules>
            <name>Next_Step_Provided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NewNextStep</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewNextStep</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_New_Next_Step</targetReference>
            </connector>
            <label>Next Step Provided</label>
        </rules>
    </decisions>
    <decisions>
        <description>Only assign Next Specific Action when the agent supplied a non-blank value.</description>
        <label>Check New Next Specific Action Provided</label>
        <locationX>176</locationX>
        <locationY>1440</locationY>
        <name>Check_New_Next_Specific_Action_Provided</name>
        <defaultConnector>
            <targetReference>Check_New_Date_Of_Next_Action_Provided</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Next Specific Action Blank</defaultConnectorLabel>
        <rules>
            <name>Next_Specific_Action_Provided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NewNextSpecificAction</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewNextSpecificAction</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_New_Next_Specific_Action</targetReference>
            </connector>
            <label>Next Specific Action Provided</label>
        </rules>
    </decisions>
    <decisions>
        <description>Only assign Date of Next Action when the agent supplied a date.</description>
        <label>Check New Date Of Next Action Provided</label>
        <locationX>176</locationX>
        <locationY>1680</locationY>
        <name>Check_New_Date_Of_Next_Action_Provided</name>
