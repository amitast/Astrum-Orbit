        <label>Assign New Stage</label>
        <locationX>440</locationX>
        <locationY>840</locationY>
        <name>Assign_New_Stage</name>
        <assignmentItems>
            <assignToReference>var_Opportunity.StageName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NewStageName</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_New_Close_Date_Provided</targetReference>
        </connector>
    </assignments>
    <assignments>
