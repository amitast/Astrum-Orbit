    <assignments>
        <description>Set outputs when the Opportunity ID is missing or not accessible.</description>
        <label>Set Fault - Opportunity Not Found</label>
        <locationX>44</locationX>
        <locationY>360</locationY>
        <name>Set_Fault_Opportunity_Not_Found</name>
        <assignmentItems>
            <assignToReference>Success</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Opportunity record not found or not accessible. Verify the opportunity ID and your record access.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Set success outputs after the single Opportunity update completes.</description>
        <label>Set Success Outputs</label>
        <locationX>176</locationX>
        <locationY>2280</locationY>
        <name>Set_Success_Outputs</name>
        <assignmentItems>
            <assignToReference>Success</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>UpdatedOpportunityName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Opportunity.Name</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Capture the update fault message without rethrowing. The agent receives the error and can ask the user to retry or escalate.</description>
        <label>Set Fault - Update Failed</label>
        <locationX>440</locationX>
        <locationY>2280</locationY>
        <name>Set_Fault_Update_Failed</name>
        <assignmentItems>
