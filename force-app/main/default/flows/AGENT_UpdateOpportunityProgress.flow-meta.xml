        <locationX>440</locationX>
        <locationY>1320</locationY>
        <name>Assign_New_Next_Step</name>
        <assignmentItems>
            <assignToReference>var_Opportunity.NextStep</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NewNextStep</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_New_Next_Specific_Action_Provided</targetReference>
