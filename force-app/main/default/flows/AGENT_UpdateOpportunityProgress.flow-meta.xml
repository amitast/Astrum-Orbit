<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Agentforce autolaunched Flow for Subagent 2. Updates one Opportunity record&apos;s progress fields in user context after Agentforce Confirm HITL. No screens, no delete elements, and no record-triggered bypass decision because this is not record-triggered.</description>
    <environments>Default</environments>
    <interviewLabel>AGENT_UpdateOpportunityProgress {!$Flow.CurrentDateTime}</interviewLabel>
    <label>AGENT_UpdateOpportunityProgress</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <recordLookups>
        <description>Retrieve the Opportunity record that the agent resolved before invoking this Flow. Runs in user context and respects the running user&apos;s record access.</description>
        <label>Get Opportunity</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <name>Get_Opportunity</name>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Opportunity_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>OpportunityId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <outputReference>var_Opportunity</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>StageName</queriedFields>
        <queriedFields>CloseDate</queriedFields>
        <queriedFields>NextStep</queriedFields>
        <queriedFields>Next_specific_action__c</queriedFields>
        <queriedFields>Date_of_next_specific_action__c</queriedFields>
        <queriedFields>Person_responsible_for_next_action__c</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <description>Exit cleanly when the Opportunity ID does not resolve to an accessible record.</description>
        <label>Check Opportunity Found</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <name>Check_Opportunity_Found</name>
        <defaultConnector>
            <targetReference>Set_Fault_Opportunity_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Opportunity Not Found</defaultConnectorLabel>
        <rules>
            <name>Opportunity_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_Opportunity.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Capture_Current_Values</targetReference>
            </connector>
            <label>Opportunity Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Detect whether the submitted CloseDate is in the past. This does not block the update; the agent uses the output to warn during Confirm HITL.</description>
        <label>Check Close Date Is Past</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <name>Check_Close_Date_Is_Past</name>
        <defaultConnector>
            <targetReference>Check_New_Stage_Provided</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Date OK or Blank</defaultConnectorLabel>
        <rules>
            <name>Close_Date_Is_Past</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NewCloseDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewCloseDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Close_Date_Is_Past</targetReference>
            </connector>
            <label>Close Date Is Past</label>
        </rules>
    </decisions>
    <decisions>
        <description>Only assign StageName when the agent supplied a non-blank stage value. This prevents blank inputs from clearing current data.</description>
        <label>Check New Stage Provided</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <name>Check_New_Stage_Provided</name>
        <defaultConnector>
            <targetReference>Check_New_Close_Date_Provided</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Stage Blank</defaultConnectorLabel>
        <rules>
            <name>Stage_Provided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NewStageName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>NewStageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_New_Stage</targetReference>
            </connector>
            <label>Stage Provided</label>
        </rules>
    </decisions>
    <decisions>
        <description>Only assign CloseDate when the agent supplied a date.</description>
        <label>Check New Close Date Provided</label>
        <locationX>176</locationX>
        <locationY>960</locationY>
