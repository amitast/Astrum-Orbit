<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>66.0</apiVersion>

    <description>Agentforce autolaunched Flow for Subagent 1. Retrieves a single Account by ID or Name using an explicit field set. Read-only, no screens, no DML, and no Bypass_Flow decision because this is not record-triggered.</description>

    <environments>Default</environments>

    <interviewLabel>AGENT_GetAccountDetails {!$Flow.CurrentDateTime}</interviewLabel>

    <label>AGENT_GetAccountDetails</label>

    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>

    <processType>AutoLaunchedFlow</processType>

    <!-- DefaultMode is the metadata value for User or Queue That Launched the Flow. Never SystemModeWithoutSharing. -->
    <runInMode>DefaultMode</runInMode>

    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_AccountId_Provided</targetReference>
        </connector>
    </start>

    <status>Active</status>

    <!-- ═══════════════════════════════════════════════
         ASSIGNMENTS  (schema group 1 of 4)
         ═══════════════════════════════════════════════ -->

    <assignments>
        <description>Populate output variables when an Account record is found. This is read-only output shaping for the agent action.</description>
        <label>Set Success Outputs</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <name>Set_Success_Outputs</name>
        <assignmentItems>
            <assignToReference>AccountFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AccountName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Industry</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.Industry</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AccountType</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.Type</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Phone</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.Phone</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Website</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.Website</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OwnerName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Owner.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NumberOfEmployees</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.NumberOfEmployees</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AnnualRevenue</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.AnnualRevenue</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>BillingCity</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.BillingCity</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>BillingCountry</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.BillingCountry</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.Description</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ClientType</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.Client_Type__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AccountSegment</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.Account_Segment__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TierCategory</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_Account.Tier_Category__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <description>Set user-safe error outputs when no accessible Account record is found.</description>
        <label>Set Account Not Found</label>
        <locationX>44</locationX>
        <locationY>480</locationY>
        <name>Set_Account_Not_Found</name>
        <assignmentItems>
            <assignToReference>AccountFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Account not found or not accessible.</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <description>Set user-safe error outputs when a read-only lookup faults. Do not expose internal exception details to the agent response.</description>
        <label>Set Fault - Query Failed</label>
        <locationX>440</locationX>
        <locationY>480</locationY>
        <name>Set_Fault_Query_Failed</name>
        <assignmentItems>
            <assignToReference>AccountFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Unable to retrieve account details. Verify the account identifier and your record access.</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <!-- ═══════════════════════════════════════════════
         DECISIONS  (schema group 2 of 4)
         ═══════════════════════════════════════════════ -->

    <decisions>
        <description>Route the lookup by AccountId when present. AccountId takes precedence over AccountName.</description>
        <label>Check AccountId Provided</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <name>Check_AccountId_Provided</name>
        <defaultConnector>
            <targetReference>Get_Account_By_Name</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Use AccountName</defaultConnectorLabel>
        <rules>
            <name>AccountId_Provided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AccountId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_By_Id</targetReference>
            </connector>
            <label>AccountId Provided</label>
        </rules>
    </decisions>

    <decisions>
        <description>Determine whether the Account lookup returned an accessible record before resolving the owner name and output fields.</description>
        <label>Evaluate Account Result</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <name>Evaluate_Account_Result</name>
        <defaultConnector>
            <targetReference>Get_Owner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Account Found</defaultConnectorLabel>
        <rules>
            <name>Account_Not_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_Account.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Account_Not_Found</targetReference>
            </connector>
            <label>Account Not Found</label>
        </rules>
    </decisions>

    <!-- ═══════════════════════════════════════════════
         RECORD LOOKUPS  (schema group 3 of 4)
         ═══════════════════════════════════════════════ -->

    <recordLookups>
        <description>Retrieve the Account record by 18-character Salesforce record ID. Stores only the explicit read field set required for the agent action.</description>
        <label>Get Account by Id</label>
        <locationX>44</locationX>
        <locationY>240</locationY>
        <name>Get_Account_By_Id</name>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Evaluate_Account_Result</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Fault_Query_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <outputReference>var_Account</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Industry</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>Phone</queriedFields>
        <queriedFields>Website</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>NumberOfEmployees</queriedFields>
        <queriedFields>AnnualRevenue</queriedFields>
        <queriedFields>BillingCity</queriedFields>
        <queriedFields>BillingCountry</queriedFields>
        <queriedFields>Description</queriedFields>
        <queriedFields>Client_Type__c</queriedFields>
        <queriedFields>Account_Segment__c</queriedFields>
        <queriedFields>Tier_Category__c</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>

    <recordLookups>
        <description>Retrieve the Account record by exact Account Name when AccountId is not provided. Stores only the explicit read field set required for the agent action.</description>
        <label>Get Account by Name</label>
        <locationX>308</locationX>
        <locationY>240</locationY>
        <name>Get_Account_By_Name</name>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Evaluate_Account_Result</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Fault_Query_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AccountName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <outputReference>var_Account</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Industry</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>Phone</queriedFields>
        <queriedFields>Website</queriedFields>
        <queriedFields>OwnerId</queriedFields>
        <queriedFields>NumberOfEmployees</queriedFields>
        <queriedFields>AnnualRevenue</queriedFields>
        <queriedFields>BillingCity</queriedFields>
        <queriedFields>BillingCountry</queriedFields>
        <queriedFields>Description</queriedFields>
        <queriedFields>Client_Type__c</queriedFields>
        <queriedFields>Account_Segment__c</queriedFields>
        <queriedFields>Tier_Category__c</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>

    <recordLookups>
        <description>Resolve the Account owner display name from OwnerId for the agent response.</description>
        <label>Get Owner</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <name>Get_Owner</name>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Success_Outputs</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Fault_Query_Failed</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_Account.OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <outputReference>var_Owner</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>

    <!-- ═══════════════════════════════════════════════
         VARIABLES  (schema group 4 of 4)
         ═══════════════════════════════════════════════ -->

    <variables>
        <description>Account Name text for lookup when AccountId is blank. On success, overwritten with the resolved Account.Name for agent output.</description>
        <name>AccountName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>18-character Account record ID. Takes precedence over AccountName when populated.</description>
        <name>AccountId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <description>True if an accessible Account record was returned.</description>
        <name>AccountFound</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Account Industry value returned from Account.Industry.</description>
        <name>Industry</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Account Type value returned from Account.Type.</description>
        <name>AccountType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Account phone number returned directly to the authenticated user.</description>
        <name>Phone</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Account website URL.</description>
        <name>Website</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Display name of the Account owner resolved from OwnerId.</description>
        <name>OwnerName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Number of employees returned from Account.NumberOfEmployees.</description>
        <name>NumberOfEmployees</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>

    <variables>
        <description>Annual revenue returned from Account.AnnualRevenue. May be blank if restricted for the running user.</description>
        <name>AnnualRevenue</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>2</scale>
    </variables>

    <variables>
        <description>Billing city returned from Account.BillingCity.</description>
        <name>BillingCity</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Billing country returned from Account.BillingCountry.</description>
        <name>BillingCountry</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Account description returned directly to the authenticated user. This Flow is not a Prompt Template input.</description>
        <name>Description</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Client type returned from Account.Client_Type__c.</description>
        <name>ClientType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Account segment returned from Account.Account_Segment__c.</description>
        <name>AccountSegment</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Tier category returned from Account.Tier_Category__c.</description>
        <name>TierCategory</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>User-safe error message returned on not-found and fault paths.</description>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <variables>
        <description>Account record returned by the selected read-only lookup.</description>
        <name>var_Account</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>

    <variables>
        <description>User record returned by the owner lookup.</description>
        <name>var_Owner</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>User</objectType>
    </variables>

</Flow>
